# Obvious leftover test data from before launch — not a real key/user pair.
STRAY_TEST_ROWS = [
    ("1111-1111-1111", 1024379666833866923),
]


def ensure_keys_present(conn: sqlite3.Connection) -> None:
    """Make sure every key we're about to restore actually exists in
    redeem_keys, in case this runs before bot.py's own startup migration
    (which normally loads keys.txt into the table)."""
    if not KEYS_FILE.exists():
        return
    wanted = {key for key, _ in RESTORED_REDEMPTIONS}
    for raw_line in KEYS_FILE.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key = line.upper()
        if key in wanted:
            conn.execute("INSERT OR IGNORE INTO redeem_keys (key) VALUES (?)", (key,))


def main() -> None:
    if not DATABASE_FILE.exists():
        raise SystemExit(f"No database at {DATABASE_FILE} — check DATA_DIR.")

    timestamp = datetime.now(timezone.utc).isoformat()
    conn = sqlite3.connect(DATABASE_FILE)
    conn.row_factory = sqlite3.Row
    ensure_keys_present(conn)

    restored = 0
    skipped: list[str] = []

    for key, user_id in RESTORED_REDEMPTIONS:
        key_row = conn.execute(
            "SELECT redeemed_by FROM redeem_keys WHERE key = ?", (key,)
        ).fetchone()
        if key_row is None:
            skipped.append(f"{key}: not found in redeem_keys (check keys.txt)")
            continue
        if key_row["redeemed_by"] is not None and key_row["redeemed_by"] != user_id:
            skipped.append(
                f"{key}: already redeemed by {key_row['redeemed_by']}, not {user_id} — left alone"
            )
            continue

        user_row = conn.execute(
            "SELECT key FROM redeemed_users WHERE user_id = ?", (user_id,)
        ).fetchone()
        if user_row is not None and user_row["key"] != key:
            skipped.append(
                f"{key}: user {user_id} already has a different key ({user_row['key']}) on file — left alone"
            )
            continue

        conn.execute(
            "UPDATE redeem_keys SET redeemed_by = ?, redeemed_at = COALESCE(redeemed_at, ?) WHERE key = ?",
            (user_id, timestamp, key),
        )
        conn.execute(
            "INSERT OR IGNORE INTO redeemed_users (user_id, key, redeemed_at) VALUES (?, ?, ?)",
            (user_id, key, timestamp),
        )
        restored += 1

    removed_stray = 0
    for key, user_id in STRAY_TEST_ROWS:
        cur = conn.execute(
            "DELETE FROM redeemed_users WHERE user_id = ? AND key = ?", (user_id, key)
        )
        removed_stray += cur.rowcount
        conn.execute(
            "UPDATE redeem_keys SET redeemed_by = NULL, redeemed_at = NULL WHERE key = ? AND redeemed_by = ?",
            (key, user_id),
        )

    conn.commit()
    conn.close()

    print(f"Restored {restored}/{len(RESTORED_REDEMPTIONS)} redemptions.")
    if removed_stray:
        print(f"Cleared {removed_stray} stray test row(s) (e.g. 1111-1111-1111).")
    if skipped:
        print("\nSkipped:")
        for line in skipped:
            print(" -", line)


if __name__ == "__main__":
    main()
